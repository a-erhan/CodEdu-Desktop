<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<StackPane xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.codedu.controllers.LoginController">

    <VBox alignment="CENTER" maxWidth="380" spacing="12">
        <padding><Insets bottom="40" left="40" right="40" top="40" /></padding>

        <!-- Logo -->
        <Label fx:id="titleLabel" text="CodEdu">
         <font>
            <Font size="30.0" />
         </font></Label>
        <Label text="The free, fun, and effective way to learn to code!" />

        <!-- Spacer -->
        <Label prefHeight="16" />

        <!-- Email field -->
        <TextField fx:id="emailField" promptText="Email" />

        <!-- Password field -->
        <PasswordField fx:id="passwordField" promptText="Password" />

        <!-- Error label -->
        <Label fx:id="errorLabel" text="" wrapText="true" />

        <!-- Login button -->
        <Button fx:id="loginButton" maxWidth="Infinity" onAction="#handleLogin" text="Login" />

        <!-- Sign Up -->
        <Button maxWidth="Infinity" onAction="#handleOpenRegister" text="Create a new account" />
    </VBox>
</StackPane>
