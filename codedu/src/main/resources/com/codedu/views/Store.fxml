<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.codedu.controllers.StoreController"
      spacing="0"
      style="-fx-background-color: #2e3440;">

    <HBox alignment="CENTER_LEFT" spacing="16">
        <padding><Insets top="25" right="40" bottom="15" left="40"/></padding>
        <VBox spacing="6">
            <Label text="Marketplace" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #F7941D;" />
            <Label text="Use your hard-earned tokens to customize your journey."
                   style="-fx-text-fill: #bdc3c7; -fx-font-size: 14px;" />
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
    </HBox>

    <Separator style="-fx-opacity: 0.1;" />

    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                style="-fx-background-color: transparent; -fx-background: transparent;">
        <VBox fx:id="storeContent" spacing="30">
            <padding><Insets top="30" right="40" bottom="40" left="40"/></padding>
        </VBox>
    </ScrollPane>
</VBox>