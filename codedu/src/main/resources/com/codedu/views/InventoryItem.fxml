<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.codedu.controllers.InventoryItemController"
      spacing="0">

    <HBox alignment="CENTER_LEFT" spacing="16">
        <padding><Insets top="20" right="28" bottom="20" left="28"/></padding>
        <VBox spacing="4">
            <Label text="Inventory"/>
            <Label text="Items you own. Equip avatars and manage quantities."/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="inventorySummaryLabel" text="0 items"/>
    </HBox>

    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
        <VBox fx:id="inventoryList" spacing="12">
            <padding><Insets top="24" right="28" bottom="24" left="28"/></padding>
        </VBox>
    </ScrollPane>
</VBox>
