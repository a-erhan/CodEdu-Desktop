<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.codedu.controllers.ForumController"
      alignment="TOP_CENTER" spacing="25" maxWidth="1200" style="-fx-background-color: #2e3440;">

    <padding><Insets top="30" right="40" bottom="30" left="40"/></padding>

    <VBox alignment="CENTER_LEFT" spacing="5">
        <Label fx:id="titleLabel" text="COMMUNITY FORUM"/>
        <Label fx:id="subtitleLabel" text="Connect with other developers and share your journey."
               style="-fx-text-fill: #bdc3c7; -fx-font-size: 13px;"/>
    </VBox>

    <HBox spacing="30" alignment="TOP_CENTER" VBox.vgrow="ALWAYS">

        <VBox spacing="15" HBox.hgrow="ALWAYS" maxWidth="750">
            <Label text="TERMINAL LOG: LATEST DISCUSSIONS" style="-fx-text-fill: #4c566a; -fx-font-weight: bold; -fx-font-size: 11px;"/>
            <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent; -fx-background-insets: 0;">
                <VBox fx:id="threadList" spacing="15">
                    <padding><Insets right="10"/></padding>
                </VBox>
            </ScrollPane>
        </VBox>

        <VBox spacing="20" prefWidth="340">
            <VBox fx:id="newPostCard" spacing="15">
                <Label text="CREATE NEW THREAD" style="-fx-text-fill: #eceff4; -fx-font-weight: bold; -fx-font-size: 11px;"/>
                <TextField fx:id="newPostTitleField" promptText="Thread Title"/>
                <TextArea fx:id="newPostBodyArea" promptText="What's on your mind?" prefRowCount="5" wrapText="true"/>
                <Button fx:id="postButton" text="POST TO FORUM" maxWidth="Infinity" prefHeight="40"/>
            </VBox>

            <VBox spacing="12" style="-fx-background-color: #3b4252; -fx-padding: 20; -fx-background-radius: 12; -fx-border-color: #4c566a; -fx-border-radius: 12;">
                <Label text="COMMUNITY RULES" style="-fx-text-fill: #00AEEF; -fx-font-weight: bold; -fx-font-size: 11px;"/>
                <Label text="• Be respectful to peers&#10;• Share helpful code snippets&#10;• Search before you post"
                       wrapText="true" style="-fx-text-fill: #eceff4; -fx-font-size: 11px; -fx-line-spacing: 5;"/>
            </VBox>
        </VBox>

    </HBox>
</VBox>