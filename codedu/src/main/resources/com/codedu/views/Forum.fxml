<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.codedu.controllers.ForumController"
      alignment="TOP_CENTER" spacing="25" maxWidth="1200" style="-fx-background-color: #1A1F25;">

    <padding><Insets top="30" right="30" bottom="30" left="30"/></padding>

    <VBox alignment="CENTER_LEFT" spacing="5">
        <Label fx:id="titleLabel" text="Community Forum"/>
        <Label fx:id="subtitleLabel" text="Connect with other developers and share your journey."/>
    </VBox>

    <HBox spacing="30" alignment="TOP_CENTER" VBox.vgrow="ALWAYS">

        <VBox spacing="15" HBox.hgrow="ALWAYS" maxWidth="750">
            <Label text="LATEST DISCUSSIONS" style="-fx-text-fill: #00ADEF; -fx-font-weight: bold; -fx-font-size: 11px;"/>
            <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;">
                <VBox fx:id="threadList" spacing="15"/>
            </ScrollPane>
        </VBox>

        <VBox spacing="20" prefWidth="320">
            <VBox fx:id="newPostCard" spacing="12">
                <Label text="NEW DISCUSSION" style="-fx-text-fill: #D9822B; -fx-font-weight: bold; -fx-font-size: 12px;"/>
                <TextField fx:id="newPostTitleField" promptText="Thread Title"/>
                <TextArea fx:id="newPostBodyArea" promptText="What's on your mind?" prefRowCount="5" wrapText="true"/>
                <Button fx:id="postButton" text="Post to Forum" maxWidth="Infinity" prefHeight="35"/>
            </VBox>

            <VBox spacing="10" style="-fx-background-color: #303846; -fx-padding: 20; -fx-background-radius: 20;">
                <Label text="COMMUNITY RULES" style="-fx-text-fill: #A0AAB4; -fx-font-weight: bold; -fx-font-size: 11px;"/>
                <Label text="• Be respectful&#10;• Post relevant code&#10;• Help others learn"
                       wrapText="true" style="-fx-text-fill: #808B96; -fx-font-size: 11px;"/>
            </VBox>
        </VBox>

    </HBox>
</VBox>