<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<VBox xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.codedu.controllers.AIChatbotController"
      alignment="TOP_CENTER" spacing="25" maxWidth="1200"
      style="-fx-background-color: #2e3440;">

    <padding>
        <Insets top="30" right="40" bottom="30" left="40"/>
    </padding>

    <VBox alignment="CENTER" spacing="8">
        <Label fx:id="titleLabel" text="AI TUTOR ASSISTANT"/>
        <Label fx:id="subtitleLabel"
               text="Paste your code and describe your logic issue to get educational guidance."
               wrapText="true" alignment="CENTER"/>
    </VBox>

    <HBox alignment="TOP_CENTER" spacing="24" VBox.vgrow="ALWAYS">

        <VBox fx:id="leftColumn" spacing="20" HBox.hgrow="ALWAYS" minWidth="450">

            <VBox fx:id="chatCard" VBox.vgrow="ALWAYS" minHeight="350">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <padding><Insets bottom="10"/></padding>
                    <Label text="TERMINAL OUTPUT" style="-fx-text-fill: #4c566a; -fx-font-weight: bold; -fx-font-size: 11px;"/>
                </HBox>

                <ScrollPane fitToWidth="true" vvalue="1.0" hbarPolicy="NEVER"
                            style="-fx-background-color: transparent; -fx-background: transparent;"
                            VBox.vgrow="ALWAYS">
                    <VBox fx:id="chatList" spacing="15">
                        <padding><Insets top="5" right="15" bottom="5" left="5"/></padding>
                    </VBox>
                </ScrollPane>
            </VBox>

            <VBox fx:id="card" spacing="15">
                <VBox spacing="8">
                    <Label fx:id="promptLabel" text="DESCRIBE"/>
                    <TextArea fx:id="questionArea"
                              promptText="What's not working?"
                              prefRowCount="3" wrapText="true"/>
                </VBox>

                <HBox spacing="15" alignment="BOTTOM_LEFT">
                    <VBox HBox.hgrow="ALWAYS" spacing="8">
                        <Label text="TOPIC TAGS" style="-fx-text-fill: #eceff4; -fx-font-size: 11px; -fx-font-weight: bold;"/>
                        <TextField fx:id="tagsField" promptText="e.g. while-loop, index-out-of-bounds"/>
                    </VBox>
                    <VBox alignment="BOTTOM_RIGHT" spacing="10">
                        <Label fx:id="requestsLabel" text="0 AI requests left"/>
                        <Button fx:id="askButton" text="SEND" disable="true"/>
                    </VBox>
                </HBox>

                <Label fx:id="noteLabel" text="Educational usage applies. One token used per response." wrapText="true"/>
            </VBox>
        </VBox>

        <VBox fx:id="codeCard" prefWidth="400" minWidth="300" VBox.vgrow="ALWAYS">
            <HBox alignment="CENTER_LEFT" spacing="8">
                <padding><Insets bottom="10"/></padding>
                <Circle radius="5" fill="#bf616a"/>
                <Circle radius="5" fill="#ebcb8b"/>
                <Circle radius="5" fill="#a3be8c"/>
                <Region prefWidth="10"/>
                <Label text="ACTIVE_EDITOR.java" style="-fx-text-fill: #4c566a; -fx-font-weight: bold; -fx-font-size: 11px;"/>
            </HBox>
            <TextArea fx:id="codeArea" VBox.vgrow="ALWAYS"
                      promptText="// Paste your snippet here..."
                      wrapText="false" style="-fx-font-family: 'Consolas', 'monospaced';"/>
        </VBox>

    </HBox>
</VBox>