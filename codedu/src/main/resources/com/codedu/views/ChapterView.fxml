<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.codedu.controllers.ChapterViewController"
            style="-fx-background-color: #2e3440;">

    <top>
        <VBox spacing="15">
            <padding><Insets top="20" right="30" bottom="5" left="30"/></padding>

            <HBox alignment="CENTER_LEFT" spacing="15">
                <Button fx:id="btnBack" text="← Back" />
                <Label fx:id="headerTitle" text="Chapter" />
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="headerXP" />
            </HBox>

            <HBox fx:id="tabBar" spacing="25" alignment="CENTER_LEFT">
                <Button fx:id="tabLearn" text="LEARN" />
                <Button fx:id="tabQuiz" text="QUIZ" />
                <Button fx:id="tabPractice" text="PRACTICE" />
            </HBox>
            <Separator style="-fx-opacity: 0.15;" />
        </VBox>
    </top>

    <center>
        <StackPane fx:id="contentStack">
            <ScrollPane fx:id="learnScroll" fitToWidth="true" hbarPolicy="NEVER"
                        style="-fx-background-color: transparent; -fx-background: transparent;">
                <VBox fx:id="learnContainer" spacing="20">
                    <padding><Insets top="25" right="45" bottom="45" left="45"/></padding>
                </VBox>
            </ScrollPane>

            <ScrollPane fx:id="quizScroll" fitToWidth="true" hbarPolicy="NEVER" visible="false"
                        style="-fx-background-color: transparent; -fx-background: transparent;">
                <VBox fx:id="quizContainer" spacing="25">
                    <padding><Insets top="25" right="45" bottom="45" left="45"/></padding>
                </VBox>
            </ScrollPane>

            <ScrollPane fx:id="practiceScroll" fitToWidth="true" hbarPolicy="NEVER" visible="false"
                        style="-fx-background-color: transparent; -fx-background: transparent;">
                <VBox fx:id="practiceContainer" spacing="25">
                    <padding><Insets top="25" right="45" bottom="45" left="45"/></padding>
                </VBox>
            </ScrollPane>
        </StackPane>
    </center>

</BorderPane>