<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.codedu.controllers.ForumPostController"
      spacing="20" style="-fx-background-color: #2e3440;">

    <padding><Insets top="30" right="40" bottom="30" left="40"/></padding>

    <HBox alignment="CENTER_LEFT" spacing="15">
        <Button fx:id="backButton" text="← BACK TO FORUM" />
    </HBox>

    <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent; -fx-background-insets: 0;" VBox.vgrow="ALWAYS">
        <VBox spacing="25">
            <padding><Insets right="15"/></padding>
            <VBox fx:id="postCard" spacing="15" style="-fx-padding: 20;">
                <VBox spacing="5">
                    <Label fx:id="titleLabel" wrapText="true" />
                    <Label fx:id="metaLabel" />
                </VBox>
                <TextArea fx:id="contentArea" editable="false" wrapText="true" prefRowCount="8"
                          style="-fx-font-size: 14px;"/>
            </VBox>

            <VBox spacing="15">
                <Label text="DISCUSSION REPLIES" style="-fx-text-fill: #4c566a; -fx-font-weight: bold; -fx-font-size: 11px;"/>
                <VBox fx:id="repliesList" spacing="15" />
            </VBox>

            <VBox spacing="15" style="-fx-background-color: #3b4252; -fx-padding: 20; -fx-background-radius: 12; -fx-border-color: #4c566a; -fx-border-radius: 12;">
                <Label text="ADD A REPLY" style="-fx-text-fill: #F7941D; -fx-font-weight: bold; -fx-font-size: 11px;"/>
                <TextArea fx:id="replyArea" promptText="Contribute to the conversation..." prefRowCount="4" wrapText="true"/>
                <HBox alignment="CENTER_RIGHT">
                    <Button fx:id="replyButton" text="POST REPLY" prefWidth="140" prefHeight="35"/>
                </HBox>
            </VBox>
        </VBox>
    </ScrollPane>
</VBox>