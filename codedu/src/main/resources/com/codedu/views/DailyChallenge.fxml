<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.codedu.controllers.DailyChallengeController"
      alignment="TOP_CENTER" maxWidth="900"
      style="-fx-background-color: #1A1F25;"> <padding>
    <Insets top="30" right="20" bottom="30" left="20"/>
</padding>

    <HBox alignment="CENTER_LEFT" spacing="15">
        <padding>
            <Insets bottom="20.0"/>
        </padding>
        <ImageView fitHeight="50.0" fitWidth="50.0" pickOnBounds="true" preserveRatio="true">
            <image>
                <Image url="@../images/app_logo.png"/>
            </image>
        </ImageView>
        <VBox alignment="CENTER_LEFT" spacing="5">
            <Label fx:id="titleLabel" text="Daily Challenges"/>
            <Label fx:id="subtitleLabel"
                   text="Tackle today’s challenges. Each card is a separate task with its own rewards."
                   wrapText="true"/>
        </VBox>
    </HBox>

    <ScrollPane fitToWidth="true" styleClass="edge-to-edge" hbarPolicy="NEVER" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent;">
        <VBox fx:id="challengeList" spacing="16" fillWidth="true" alignment="TOP_CENTER">
            <padding>
                <Insets top="10" bottom="20"/>
            </padding>
        </VBox>
    </ScrollPane>

</VBox>