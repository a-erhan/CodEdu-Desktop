<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.codedu.controllers.DailyChallengeController"
      alignment="TOP_CENTER" maxWidth="1000"
      style="-fx-background-color: #2e3440;">

    <padding>
        <Insets top="30" right="40" bottom="30" left="40"/>
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="20">
        <padding><Insets bottom="25.0"/></padding>
        <ImageView fitHeight="45.0" fitWidth="45.0" pickOnBounds="true" preserveRatio="true">
            <image>
                <Image url="@../images/app_logo.png"/>
            </image>
        </ImageView>
        <VBox alignment="CENTER_LEFT" spacing="4">
            <Label fx:id="titleLabel" text="DAILY MISSIONS"/>
            <Label fx:id="subtitleLabel"
                   text="Solve today's coding challenges to earn XP and strengthen your developer profile."
                   style="-fx-text-fill: #bdc3c7; -fx-font-size: 13px;" wrapText="true"/>
        </VBox>
    </HBox>

    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS"
                style="-fx-background-color: transparent; -fx-background: transparent; -fx-background-insets: 0;">
        <VBox fx:id="challengeList" spacing="20" fillWidth="true" alignment="TOP_CENTER">
            <padding><Insets top="10" bottom="20" right="10"/></padding>
        </VBox>
    </ScrollPane>

</VBox>