<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="TOP_CENTER" fillWidth="true" spacing="25" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.codedu.controllers.LeaderboardController">
    <padding>
        <Insets bottom="20" left="50" right="50" top="20" />
    </padding>

    <Label fx:id="titleLabel" text="Leaderboard" />
    <HBox alignment="CENTER_LEFT" spacing="20">
        <VBox spacing="5">
            <Label fx:id="titleLabel" text="Leaderboard" />
            <Label fx:id="subtitleLabel" text="See how you rank against other learners." wrapText="true" />
        </VBox>

        <Region HBox.hgrow="ALWAYS" />

        <ComboBox fx:id="scopeComboBox" prefWidth="150" style="-fx-cursor: hand;" />
    </HBox>
    <Label fx:id="subtitleLabel" text="See how you rank against other learners this week." wrapText="true" />

    <!-- Card for the current user -->
    <VBox fx:id="myCard" alignment="CENTER" prefHeight="63.0" prefWidth="200.0" spacing="6">
        <Label fx:id="myTitle" alignment="CENTER" contentDisplay="CENTER" text="Your position" />
        <Label fx:id="myRankLabel" alignment="CENTER" contentDisplay="CENTER" text="#4 of 10 · You" />
        <Label fx:id="myScoreLabel" alignment="CENTER" contentDisplay="CENTER" text="2000 XP · 60% wins" />
    </VBox>

    <!-- Full leaderboard list -->
    <VBox fx:id="boardList" alignment="TOP_CENTER" spacing="18" maxWidth="800" fillWidth="true" />

</VBox>
